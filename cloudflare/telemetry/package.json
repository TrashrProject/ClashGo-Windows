{
  "name": "clashgo-telemetry-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create clashgo-telemetry",
    "db:init:local": "wrangler d1 execute clashgo-telemetry --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute clashgo-telemetry --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}